{
  "name": "@steellgold/mktree",
  "version": "1.0.0",
  "type": "module",
  "description": "Generate beautiful project tree structures from the command line",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "readme": "README.md",
  "files": [
    "bin/",
    "dist/"
  ],
  "bin": {
    "mktree": "./bin/mktree.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "ts-node src/index.ts",
    "test": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "keywords": [
    "tree",
    "directory",
    "project",
    "structure",
    "cli"
  ],
  "author": "Steellgold",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "inquirer": "^13.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2",
    "vitest": "^4.1.1"
  }
}
